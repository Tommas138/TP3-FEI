# Dirección de la API vista desde el celular. Copiar a .env y completar.
# - Celular real: la IP de la notebook en la misma Wi-Fi (ipconfig → "Dirección IPv4").
#   "localhost" desde el celular es el propio celular, no la notebook.
# - Emulador de Android: http://10.0.2.2:3000
# Se reemplaza al compilar: después de cambiarla, reiniciar con npx expo start --clear.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
